# Copy to GitHub repo Secrets (Settings > Secrets and variables > Actions). Do NOT commit real keys.
FMP_API_KEY=                 # FMP Starter 年付（2026-07-18 由 Ultimate 降级；batch-quote 需 Premium+，已走单票 fallback B31）
ANTHROPIC_API_KEY=           # Anthropic API (pay-go; NOT Claude Pro)
# Email (SMTP) — e.g. Gmail app password (not login password)
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=             # comma-separated; blank = send to sender
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# IBKR — pick your adapter (see cockpit/ibkr.py). Examples:
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# Behavior overrides (optional)
FORCE_RUN=false             # true = run even on US holidays
